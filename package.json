{
  "name": "puzzlecub-web",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "build:classic": "./scripts/build-classic.sh",
    "build:all": "npm run build:classic && npm run build:chaturang && npm run build:collection && npm run build",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test",
    "prebuild": "node scripts/classic-fingerprint.mjs && node scripts/chaturang-fingerprint.mjs && node scripts/collection-fingerprint.mjs",
    "build:chaturang": "./scripts/build-chaturang.sh",
    "build:collection": "./scripts/build-collection.sh"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.0",
    "next": "16.2.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.1",
    "prettier": "^3.9.9",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
