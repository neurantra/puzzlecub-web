# Server-only: connection string for a dedicated PuzzleCub Neon database.
DATABASE_URL=
# Generate a unique random password (at least 16 characters).
ADMIN_PASSWORD=
# Independent random secret (at least 32 characters).
ADMIN_SESSION_SECRET=
# Independent random secret for Vercel's daily retention job.
CRON_SECRET=
# Enable only after applying database/analytics.sql and configuring the secrets.
# This public build-time flag requires a redeploy when changed.
NEXT_PUBLIC_ANALYTICS_ENABLED=false
# Optional canonical origin. Leave unset for local/preview host-relative checks.
# SITE_ORIGIN=https://puzzlecub.com
# Vercel's protected IP header is detected automatically on Vercel.
# Outside Vercel, configure ONLY a header overwritten by your trusted proxy.
# ANALYTICS_TRUSTED_IP_HEADER=

# AdSense publisher/slot IDs are public, but configured server-side.
# Public publisher ID from AdSense. public/ads.txt is served independently.
ADSENSE_CLIENT=ca-pub-5992130091579926
ADSENSE_CONTENT_SLOT=
ADSENSE_GAMEPLAY_SLOT=
# Leave off until AdSense approves puzzlecub.com.
ADS_ENABLED=false
# Publish Google's certified consent message before enabling live requests.
ADS_CONSENT_READY=false
# Separate H5 Games Ads approval is required for live interstitials.
H5_ADS_ENABLED=false
# Use only on local/preview deployments to request Google's test ads.
ADS_TEST_MODE=false
